@using RW.VAC.Client.Models
@using RW.VAC.Domain.Products
@using RW.VAC.Domain.Location
@using System.ComponentModel.DataAnnotations

@inherits ComponentBase
@inject IProductService ProductService
@inject ILocationService LocationService
@inject INotificationService NotificationService

<Form Model="@Model" OnFinish="OnFinish" OnFinishFailed="OnFinishFailed">
    <FormItem Label="库位ID">
        <Input @bind-Value="@Model.LocationId" Disabled="true" />
    </FormItem>

    <FormItem Label="选择产品" Required>
        <Select @bind-Value="@Model.ProductId"
                DataSource="@_availableProducts"
                ValueName="@nameof(ProductSelectItem.ProductId)"
                LabelName="@nameof(ProductSelectItem.DisplayName)"
                Placeholder="请选择产品"
                Loading="@_loadingProducts"
                NotFoundContent="@(_loadingProducts ? "加载中..." : "暂无可用产品")"
                OnSelectedItemChanged="OnProductSelected">
            <SelectOptions>
                @if (_availableProducts != null)
                {
                    @foreach (var product in _availableProducts)
                    {
                        <SelectOption Value="@product.ProductId" Label="@product.DisplayName">
                            <div class="product-option">
                                <div class="product-name">@product.ProductName</div>
                                <div class="product-info">
                                    <Tag Color="@GetProductTypeColor(product.ProductType)">@product.ProductType</Tag>
                                    <span class="product-status">@product.Status</span>
                                </div>
                            </div>
                        </SelectOption>
                    }
                }
            </SelectOptions>
        </Select>
    </FormItem>

    @if (_selectedProduct != null)
    {
        <FormItem Label="产品详情">
            <div class="product-details">
                <div class="detail-row">
                    <span class="label">产品名称:</span>
                    <span class="value">@_selectedProduct.ProductName</span>
                </div>
                <div class="detail-row">
                    <span class="label">产品类型:</span>
                    <span class="value">
                        <Tag Color="@GetProductTypeColor(_selectedProduct.ProductType)">@_selectedProduct.ProductType</Tag>
                    </span>
                </div>
                <div class="detail-row">
                    <span class="label">产品状态:</span>
                    <span class="value">@_selectedProduct.Status</span>
                </div>
                @if (!string.IsNullOrEmpty( _selectedProduct.ProductSpecs ))
                {
                    <div class="detail-row">
                        <span class="label">产品规格:</span>
                        <span class="value">@_selectedProduct.ProductSpecs</span>
                    </div>
                }
            </div>
        </FormItem>
    }

    <FormItem Label="备注信息">
        <TextArea @bind-Value="@Model.Remarks"
                  Placeholder="请输入备注信息（可选）"
                  Rows="3"
                  MaxLength="500"
                  ShowCount="true" />
    </FormItem>

    <FormItem>
        <Button Type="@ButtonType.Primary"
                HtmlType="submit"
                Loading="@_assigning"
                Disabled="@(string.IsNullOrEmpty(Model.ProductId))">
            <Icon Type="plus" /> 分配产品
        </Button>
        <Button OnClick="OnCancel" Style="margin-left: 8px;">
            取消
        </Button>
    </FormItem>
</Form>

@code {
    [Parameter] public AssignProductModalModel Model { get; set; } = new();
    [Parameter] public EventCallback OnSuccess { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private List<ProductSelectItem> _availableProducts = new();
    private bool _loadingProducts = false;
    private bool _assigning = false;
    private Product _selectedProduct;

    protected override async Task OnInitializedAsync( )
    {
        await LoadAvailableProducts();
    }

    private async Task LoadAvailableProducts( )
    {
        _loadingProducts = true;
        try
        {
            // 获取所有可用产品（没有分配给任何位置的产品）
            var allProducts = await ProductService.GetAllProductsAsync();
            var productsWithoutLocation = allProducts.Where( p => string.IsNullOrEmpty( p.LocationId ) );

            _availableProducts = productsWithoutLocation.Select( p => new ProductSelectItem
                {
                    ProductId = p.ProductId ,
                    ProductName = p.ProductName ,
                    ProductType = p.ProductType.ToString() ,
                    Status = p.Status ,
                    ProductSpecs = p.ProductSpecs ,
                    DisplayName = $"{p.ProductName} ({p.ProductId})"
                } ).ToList();
        }
        catch (Exception ex)
        {
            await NotificationService.Error( new NotificationConfig
                {
                    Message = "加载产品列表失败" ,
                    Description = ex.Message
                } );
        }
        finally
        {
            _loadingProducts = false;
            StateHasChanged();
        }
    }

    private void OnProductSelected( ProductSelectItem item )
    {
        if (item != null)
        {
            _selectedProduct = new Product
                {
                    ProductId = item.ProductId ,
                    ProductName = item.ProductName ,
                    ProductType = Enum.Parse<ProductType>( item.ProductType ) ,
                    Status = item.Status ,
                    ProductSpecs = item.ProductSpecs
                };
        }
        else
        {
            _selectedProduct = null;
        }
        StateHasChanged();
    }

    private string GetProductTypeColor( string productType )
    {
        return productType switch
        {
            "制动装置" => "blue",
            "辅助装置" => "green",
            _ => "default"
        };
    }

    private async Task OnFinish( )
    {
        if (string.IsNullOrEmpty( Model.ProductId ))
        {
            await NotificationService.Warning( new NotificationConfig
                {
                    Message = "请选择产品" ,
                    Description = "必须选择一个产品才能进行分配"
                } );
            return;
        }

        _assigning = true;
        try
        {
            // 调用服务分配产品
            var result = await LocationService.AssignProductToLocationAsync( Model.LocationId , Model.ProductId );

            if (result)
            {
                await NotificationService.Success( new NotificationConfig
                    {
                        Message = "产品分配成功" ,
                        Description = $"产品 {Model.ProductId} 已成功分配到库位 {Model.LocationId}"
                    } );

                if (OnSuccess.HasDelegate)
                {
                    await OnSuccess.InvokeAsync();
                }
            }
            else
            {
                await NotificationService.Error( new NotificationConfig
                    {
                        Message = "产品分配失败" ,
                        Description = "分配操作未成功完成"
                    } );
            }
        }
        catch (Exception ex)
        {
            await NotificationService.Error( new NotificationConfig
                {
                    Message = "产品分配失败" ,
                    Description = ex.Message
                } );
        }
        finally
        {
            _assigning = false;
            StateHasChanged();
        }
    }

    private async Task OnFinishFailed( EditContext editContext )
    {
        await NotificationService.Warning( new NotificationConfig
            {
                Message = "表单验证失败" ,
                Description = "请检查并修正表单中的错误"
            } );
    }

    // 产品选择项
    public class ProductSelectItem
    {
        public string ProductId { get; set; }
        public string ProductName { get; set; }
        public string ProductType { get; set; }
        public string Status { get; set; }
        public string ProductSpecs { get; set; }
        public string DisplayName { get; set; }
    }
}

<style>
    .product-option {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .product-name {
        font-weight: 500;
        color: #1890ff;
    }

    .product-info {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
    }

    .product-status {
        color: #666;
    }

    .product-details {
        background: #f5f5f5;
        padding: 12px;
        border-radius: 4px;
    }

    .detail-row {
        display: flex;
        margin-bottom: 8px;
    }

        .detail-row:last-child {
            margin-bottom: 0;
        }

        .detail-row .label {
            width: 80px;
            font-weight: 500;
            color: #666;
        }

        .detail-row .value {
            flex: 1;
            color: #333;
        }
</style>