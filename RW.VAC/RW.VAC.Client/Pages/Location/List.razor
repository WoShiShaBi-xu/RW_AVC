@page "/location"
@using RW.VAC.Domain.Location
@using RW.VAC.Domain.DockingPosition
@using System.Linq
@using System.Threading
@using RW.VAC.Client.Pages.Location
@using RW.VAC.Client.Models

<SectionContent SectionName="navBread">
    <NavBread>
        <NavTemplate>
            <BreadcrumbItem>位置管理</BreadcrumbItem>
        </NavTemplate>
    </NavBread>
</SectionContent>

<div class="rw-content">
    <Tabs DefaultActiveKey="1">
        <TabPane Key="1" Tab="库位管理">
            <div class="action-bar">
                <Space>
                    <SpaceItem>
                        <Select TItem="LocationTypeItem"
                                TItemValue="LocationType?"
                                DataSource="@LocationTypes"
                                @bind-Value="@_selectedLocationType"
                                ValueName="@nameof(LocationTypeItem.Value)"
                                LabelName="@nameof(LocationTypeItem.Label)"
                                Style="width: 200px"
                                Placeholder="选择库位类型"
                                AllowClear
                                OnSelectedItemChanged="EventCallback.Factory.Create<LocationTypeItem>(this, OnLocationTypeChanged)">
                        </Select>
                    </SpaceItem>
                    <SpaceItem>
                        <Select TItem="LocationStatusItem"
                                TItemValue="LocationStatusFilter?"
                                DataSource="@LocationStatusFilters"
                                @bind-Value="@_selectedLocationStatus"
                                ValueName="@nameof(LocationStatusItem.Value)"
                                LabelName="@nameof(LocationStatusItem.Label)"
                                Style="width: 200px"
                                Placeholder="选择状态筛选"
                                AllowClear
                                OnSelectedItemChanged="EventCallback.Factory.Create<LocationStatusItem>(this, OnLocationStatusChanged)">
                        </Select>
                    </SpaceItem>
                    <SpaceItem>
                        <Input Placeholder="搜索库位..." @bind-Value="@_locationSearchText" OnPressEnter="SearchLocations" />
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="primary" OnClick="RefreshLocations">
                            <Icon Type="reload" /> 刷新
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="primary" OnClick="AddNewLocation">
                            <Icon Type="plus" /> 新增库位
                        </Button>
                    </SpaceItem>
                </Space>
            </div>

            @if (_loadingLocations)
            {
                <div class="loading-container">
                    <Spin Tip="正在加载库位数据..."></Spin>
                </div>
            }
            else
            {
                <div class="location-groups">
                    @foreach (var locationGroup in _groupedLocations.OrderBy( g => g.Key ))
                    {
                        var stats = GetLocationTypeStats( locationGroup.Key );
                        var typeClass = GetLocationTypeClass( locationGroup.Key );

                        <div class="location-group @typeClass">
                            <div class="group-header">
                                <div class="group-title">@GetLocationTypeName( locationGroup.Key )</div>
                                <div class="group-stats">
                                    <div class="stat-item stat-empty">
                                        <Icon Type="inbox" /> 空闲: @stats.empty
                                    </div>
                                    <div class="stat-item stat-pallet-only">
                                        <Icon Type="container" /> 仅托盘: @stats.palletOnly
                                    </div>
                                    <div class="stat-item stat-full">
                                        <Icon Type="check-circle" /> 托盘+产品: @stats.full
                                    </div>
                                    <div class="stat-item stat-abnormal">
                                        <Icon Type="warning" /> 异常: @stats.abnormal
                                    </div>
                                    <div class="stat-item">
                                        <Icon Type="database" /> 总计: @stats.total
                                    </div>
                                </div>
                            </div>
                            <div class="location-grid">
                                @foreach (var location in locationGroup.Value.OrderBy( l => l.LocationId ))
                                {
                                    var locationStatus = GetLocationStatus( location );
                                    var statusClass = GetLocationStatusClass( locationStatus );

                                    <Card Bordered Class="@($"location-card {statusClass}")">
                                        <div class="location-header">
                                            <div class="location-code">@location.LocationId</div>
                                            <div class="location-status">
                                                @GetLocationStatusTag( locationStatus )
                                            </div>
                                        </div>
                                        <div class="location-name">@location.LocationName</div>
                                        <div class="location-type">类型: @GetLocationTypeName( location.LocationType )</div>

                                        <div class="location-content">
                                            @if (!string.IsNullOrEmpty( location.CurrentPalletId ))
                                            {
                                                <div class="location-pallet">
                                                    <Icon Type="container" />
                                                    <span>托盘: </span>
                                                    <Tag Color="blue">@location.CurrentPalletId</Tag>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty( location.CurrentProductId ))
                                            {
                                                <div class="location-product">
                                                    <Icon Type="box-plot" />
                                                    <span>产品: </span>
                                                    <Tag Color="green">@location.CurrentProductId</Tag>
                                                </div>
                                            }

                                            @if (string.IsNullOrEmpty( location.CurrentPalletId ) && string.IsNullOrEmpty( location.CurrentProductId ))
                                            {
                                                <div class="location-empty">
                                                    <Icon Type="inbox" />
                                                    <span class="text-muted">空闲状态</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="location-update">
                                            <Icon Type="clock-circle" /> 更新时间: @(location.LastUpdate?.ToString( "yyyy-MM-dd HH:mm:ss" ) ?? "-")
                                        </div>

                                        <div class="location-actions">
                                            <Button Type="primary" Size="small" OnClick="() => ViewLocationDetails(location)">
                                                <Icon Type="eye" /> 详情
                                            </Button>
                                            <Button Type="default" Size="small" OnClick="() => EditLocation(location)">
                                                <Icon Type="edit" /> 编辑
                                            </Button>

                                            @if (string.IsNullOrEmpty( location.CurrentPalletId ))
                                            {
                                                <Button Type="default" Size="small" OnClick="() => ManagePallet(location)">
                                                    <Icon Type="plus-circle" /> 分配托盘
                                                </Button>
                                            }
                                            else
                                            {
                                                <Button Type="danger" Size="small" OnClick="() => ManagePallet(location)">
                                                    <Icon Type="minus-circle" /> 移除托盘
                                                </Button>
                                            }

                                            @if (!string.IsNullOrEmpty( location.CurrentPalletId ))
                                            {
                                                @if (string.IsNullOrEmpty( location.CurrentProductId ))
                                                {
                                                    <Button Type="default" Size="small" OnClick="() => ManageProduct(location)">
                                                        <Icon Type="plus-circle" /> 分配产品
                                                    </Button>
                                                }
                                                else
                                                {
                                                    <Button Type="danger" Size="small" OnClick="() => ManageProduct(location)">
                                                        <Icon Type="minus-circle" /> 移除产品
                                                    </Button>
                                                }
                                            }

                                            <Button Danger Size="small" OnClick="() => DeleteLocation(location)"
                                                    Disabled="@(!string.IsNullOrEmpty(location.CurrentPalletId) || !string.IsNullOrEmpty(location.CurrentProductId))">
                                                <Icon Type="delete" /> 删除
                                            </Button>
                                        </div>
                                    </Card>
                                }
                            </div>

                            @if (!locationGroup.Value.Any())
                            {
                                <div class="empty-state">
                                    <Icon Type="inbox" />
                                    <span>该类型暂无库位</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (!_groupedLocations.Any())
                {
                    <Empty>
                        <DescriptionTemplate>暂无库位数据</DescriptionTemplate>
                    </Empty>
                }
            }
        </TabPane>

        <TabPane Key="2" Tab="接驳位管理">
            <div class="action-bar">
                <Space>
                    <SpaceItem>
                        <Select TItem="DockingStatusItem"
                                TItemValue="DockingStatusFilter?"
                                DataSource="@DockingStatusFilters"
                                @bind-Value="@_selectedDockingStatus"
                                ValueName="@nameof(DockingStatusItem.Value)"
                                LabelName="@nameof(DockingStatusItem.Label)"
                                Style="width: 200px"
                                Placeholder="选择状态筛选"
                                AllowClear
                                OnSelectedItemChanged="EventCallback.Factory.Create<DockingStatusItem>(this, OnDockingStatusChanged)">
                        </Select>
                    </SpaceItem>
                    <SpaceItem>
                        <Input Placeholder="搜索接驳位..." @bind-Value="@_dockingSearchText" OnPressEnter="SearchDockingPositions" />
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="primary" OnClick="RefreshDockingPositions">
                            <Icon Type="reload" /> 刷新
                        </Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Type="primary" OnClick="AddNewDockingPosition">
                            <Icon Type="plus" /> 新增接驳位
                        </Button>
                    </SpaceItem>
                </Space>
            </div>

            @if (_loadingDockingPositions)
            {
                <div class="loading-container">
                    <Spin Tip="正在加载接驳位数据..."></Spin>
                </div>
            }
            else
            {
                <div class="docking-groups">
                    @foreach (var positionGroup in _groupedDockingPositions.OrderBy( g => g.Key ))
                    {
                        var stats = GetDockingPositionTypeStats( positionGroup.Key );
                        var typeClass = GetDockingPositionTypeClass( positionGroup.Key );
                        var displayName = GetDockingPositionTypeDisplayName( positionGroup.Key );

                        <div class="docking-group @typeClass">
                            <div class="group-header">
                                <div class="group-title">@displayName</div>
                                <div class="group-stats">
                                    <div class="stat-item stat-empty">
                                        <Icon Type="inbox" /> 空闲: @stats.empty
                                    </div>
                                    <div class="stat-item stat-pallet-only">
                                        <Icon Type="container" /> 仅托盘: @stats.palletOnly
                                    </div>
                                    <div class="stat-item stat-full">
                                        <Icon Type="check-circle" /> 托盘+产品: @stats.full
                                    </div>
                                    <div class="stat-item stat-abnormal">
                                        <Icon Type="warning" /> 异常: @stats.abnormal
                                    </div>
                                    <div class="stat-item">
                                        <Icon Type="database" /> 总计: @stats.total
                                    </div>
                                </div>
                            </div>

                            <div class="docking-grid">
                                @foreach (var position in positionGroup.Value.OrderBy( p => p.PositionId ))
                                {
                                    var positionStatus = GetDockingPositionStatus( position );
                                    var statusClass = GetDockingPositionStatusClass( positionStatus );

                                    <Card Bordered Class="@($"docking-card {statusClass}")">
                                        <div class="docking-header">
                                            <div class="docking-code">@position.PositionId</div>
                                            <div class="docking-status">
                                                @GetDockingPositionStatusTag( positionStatus )
                                            </div>
                                        </div>
                                        <div class="docking-type">类型: @position.PositionType</div>

                                        @if (!string.IsNullOrEmpty( position.StationId ))
                                        {
                                            <div class="docking-station">
                                                <Icon Type="desktop" />
                                                <span>关联试验台: </span>
                                                <Tag Color="blue">@position.StationId</Tag>
                                            </div>
                                        }

                                        <div class="docking-content">
                                            @if (!string.IsNullOrEmpty( position.CurrentPalletId ))
                                            {
                                                <div class="docking-pallet">
                                                    <Icon Type="container" />
                                                    <span>托盘: </span>
                                                    <Tag Color="blue">@position.CurrentPalletId</Tag>
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty( position.CurrentProductld ))
                                            {
                                                <div class="docking-product">
                                                    <Icon Type="box-plot" />
                                                    <span>产品: </span>
                                                    <Tag Color="green">@position.CurrentProductld</Tag>
                                                </div>
                                            }

                                            @if (string.IsNullOrEmpty( position.CurrentPalletId ) && string.IsNullOrEmpty( position.CurrentProductld ))
                                            {
                                                <div class="docking-empty">
                                                    <Icon Type="inbox" />
                                                    <span class="text-muted">空闲状态</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="docking-update">
                                            <Icon Type="clock-circle" /> 更新时间: @(position.LastUpdate?.ToString( "yyyy-MM-dd HH:mm:ss" ) ?? "-")
                                        </div>

                                        <div class="docking-actions">
                                            <Button Type="primary" Size="small" OnClick="() => ViewDockingDetails(position)">
                                                <Icon Type="eye" /> 详情
                                            </Button>
                                            <Button Type="default" Size="small" OnClick="() => EditDockingPosition(position)">
                                                <Icon Type="edit" /> 编辑
                                            </Button>

                                            @if (string.IsNullOrEmpty( position.CurrentPalletId ))
                                            {
                                                <Button Type="default" Size="small" OnClick="() => ManageDockingPallet(position)">
                                                    <Icon Type="plus-circle" /> 分配托盘
                                                </Button>
                                            }
                                            else
                                            {
                                                <Button Type="danger" Size="small" OnClick="() => ManageDockingPallet(position)">
                                                    <Icon Type="minus-circle" /> 移除托盘
                                                </Button>
                                            }

                                            @if (!string.IsNullOrEmpty( position.CurrentPalletId ))
                                            {
                                                @if (string.IsNullOrEmpty( position.CurrentProductld ))
                                                {
                                                    <Button Type="default" Size="small" OnClick="() => ManageDockingProduct(position)">
                                                        <Icon Type="plus-circle" /> 分配产品
                                                    </Button>
                                                }
                                                else
                                                {
                                                    <Button Type="danger" Size="small" OnClick="() => ManageDockingProduct(position)">
                                                        <Icon Type="minus-circle" /> 移除产品
                                                    </Button>
                                                }
                                            }

                                            <Button Danger Size="small" OnClick="() => DeleteDockingPosition(position)"
                                                    Disabled="@(!string.IsNullOrEmpty(position.CurrentPalletId) || !string.IsNullOrEmpty(position.CurrentProductld))">
                                                <Icon Type="delete" /> 删除
                                            </Button>
                                        </div>
                                    </Card>
                                }
                            </div>

                            @if (!positionGroup.Value.Any())
                            {
                                <div class="empty-state">
                                    <Icon Type="inbox" />
                                    <span>该类型暂无接驳位</span>
                                </div>
                            }
                        </div>
                    }
                </div>

                @if (!_groupedDockingPositions.Any())
                {
                    <Empty>
                        <DescriptionTemplate>暂无接驳位数据</DescriptionTemplate>
                    </Empty>
                }
            }
        </TabPane>
    </Tabs>
</div>

@code {
    // 依赖注入服务
    [Inject] private ILocationService LocationService { get; set; }
    [Inject] private IDockingPositionService DockingPositionService { get; set; }

    // 库位数据
    private List<Location> _locations = new();
    private List<Location> _filteredLocations = new();
    private bool _loadingLocations = true;
    private string _locationSearchText = string.Empty;
    private LocationType? _selectedLocationType;
    private LocationStatusFilter? _selectedLocationStatus;
    private Dictionary<LocationType , List<Location>> _groupedLocations = new();
    private Dictionary<string , List<DockingPosition>> _groupedDockingPositions = new();

    // 接驳位数据
    private List<DockingPosition> _dockingPositions = new();
    private List<DockingPosition> _filteredDockingPositions = new();
    private bool _loadingDockingPositions = true;
    private string _dockingSearchText = string.Empty;
    private DockingStatusFilter? _selectedDockingStatus;

    // 库位类型选项
    private List<LocationTypeItem> LocationTypes { get; set; } = new();

    // 库位状态筛选选项
    private List<LocationStatusItem> LocationStatusFilters { get; set; } = new();

    // 接驳位状态筛选选项
    private List<DockingStatusItem> DockingStatusFilters { get; set; } = new();

    // 定义状态枚举
    public enum LocationStatusFilter
    {
        空闲,
        仅托盘,
        托盘和产品,
        异常状态
    }

    public enum DockingStatusFilter
    {
        空闲,
        仅托盘,
        托盘和产品,
        异常状态
    }

    public enum DetailedLocationStatus
    {
        空闲,      // 无托盘无产品
        仅托盘,    // 有托盘无产品
        完整,      // 有托盘有产品
        异常       // 无托盘有产品
    }

    public enum DetailedDockingStatus
    {
        空闲,      // 无托盘无产品
        仅托盘,    // 有托盘无产品
        完整,      // 有托盘有产品
        异常       // 无托盘有产品
    }

    protected override async Task OnInitializedAsync( )
    {
        // 初始化库位类型列表
        LocationTypes = Enum.GetValues( typeof( LocationType ) )
        .Cast<LocationType>()
        .Select( t => new LocationTypeItem
                {
                    Value = t ,
                    Label = GetLocationTypeName( t )
                } )
        .ToList();

        // 初始化库位状态筛选列表
        LocationStatusFilters = Enum.GetValues( typeof( LocationStatusFilter ) )
        .Cast<LocationStatusFilter>()
        .Select( s => new LocationStatusItem
                {
                    Value = s ,
                    Label = s.ToString()
                } )
        .ToList();

        // 初始化接驳位状态筛选列表
        DockingStatusFilters = Enum.GetValues( typeof( DockingStatusFilter ) )
        .Cast<DockingStatusFilter>()
        .Select( s => new DockingStatusItem
                {
                    Value = s ,
                    Label = s.ToString()
                } )
        .ToList();

        // 加载数据
        await LoadData();
    }

    private async Task LoadData( )
    {
        await Task.WhenAll( LoadLocations() , LoadDockingPositions() );
    }

    private async Task LoadLocations( )
    {
        _loadingLocations = true;
        try
        {
            // 获取所有库位
            var locations = await LocationService.GetAllLocationsAsync();
            _locations = locations.ToList();
            FilterLocations();
        }
        catch (Exception ex)
        {
            await NotificationService.Error( new NotificationConfig
                    {
                        Message = "加载库位数据失败" ,
                        Description = ex.Message
                    } );
        }
        finally
        {
            _loadingLocations = false;
            StateHasChanged();
        }
    }

    private async Task LoadDockingPositions( )
    {
        _loadingDockingPositions = true;
        try
        {
            // 获取所有接驳位
            var positions = await DockingPositionService.GetAllDockingPositionsAsync();
            _dockingPositions = positions.ToList();
            FilterDockingPositions();
        }
        catch (Exception ex)
        {
            await NotificationService.Error( new NotificationConfig
                    {
                        Message = "加载接驳位数据失败" ,
                        Description = ex.Message
                    } );
        }
        finally
        {
            _loadingDockingPositions = false;
            StateHasChanged();
        }
    }

    // 获取库位详细状态
    private DetailedLocationStatus GetLocationStatus( Location location )
    {
        bool hasPallet = !string.IsNullOrEmpty( location.CurrentPalletId );
        bool hasProduct = !string.IsNullOrEmpty( location.CurrentProductId );

        return (hasPallet, hasProduct) switch
        {
            (false, false ) => DetailedLocationStatus.空闲,
            (true, false ) => DetailedLocationStatus.仅托盘,
            (true, true ) => DetailedLocationStatus.完整,
            (false, true ) => DetailedLocationStatus.异常
        };
    }

    // 获取接驳位详细状态
    private DetailedDockingStatus GetDockingPositionStatus( DockingPosition position )
    {
        bool hasPallet = !string.IsNullOrEmpty( position.CurrentPalletId );
        bool hasProduct = !string.IsNullOrEmpty( position.CurrentProductld );

        return (hasPallet, hasProduct) switch
        {
            (false, false ) => DetailedDockingStatus.空闲,
            (true, false ) => DetailedDockingStatus.仅托盘,
            (true, true ) => DetailedDockingStatus.完整,
            (false, true ) => DetailedDockingStatus.异常
        };
    }

    // 获取库位状态CSS类
    private string GetLocationStatusClass( DetailedLocationStatus status )
    {
        return status switch
        {
            DetailedLocationStatus.空闲 => "location-empty",
            DetailedLocationStatus.仅托盘 => "location-pallet-only",
            DetailedLocationStatus.完整 => "location-full",
            DetailedLocationStatus.异常 => "location-abnormal",
            _ => "location-unknown"
        };
    }

    // 获取接驳位状态CSS类
    private string GetDockingPositionStatusClass( DetailedDockingStatus status )
    {
        return status switch
        {
            DetailedDockingStatus.空闲 => "docking-empty",
            DetailedDockingStatus.仅托盘 => "docking-pallet-only",
            DetailedDockingStatus.完整 => "docking-full",
            DetailedDockingStatus.异常 => "docking-abnormal",
            _ => "docking-unknown"
        };
    }

    // 获取库位状态标签
    private RenderFragment GetLocationStatusTag( DetailedLocationStatus status )
    {
        return status switch
        {
            DetailedLocationStatus.空闲 => @<Tag Color="default">空闲</Tag>,
            DetailedLocationStatus.仅托盘 => @<Tag Color="orange">仅托盘</Tag>,
            DetailedLocationStatus.完整 => @<Tag Color="green">托盘+产品</Tag>,
            DetailedLocationStatus.异常 => @<Tag Color="red">异常状态</Tag>,
            _ => @<Tag Color="gray">未知状态</Tag>
        };
    }

    // 获取接驳位状态标签
    private RenderFragment GetDockingPositionStatusTag( DetailedDockingStatus status )
    {
        return status switch
        {
            DetailedDockingStatus.空闲 => @<Tag Color="default">空闲</Tag>,
            DetailedDockingStatus.仅托盘 => @<Tag Color="orange">仅托盘</Tag>,
            DetailedDockingStatus.完整 => @<Tag Color="green">托盘+产品</Tag>,
            DetailedDockingStatus.异常 => @<Tag Color="red">异常状态</Tag>,
            _ => @<Tag Color="gray">未知状态</Tag>
        };
    }

    private void FilterLocations( )
    {
        _filteredLocations = _locations;

        // 按类型筛选
        if (_selectedLocationType.HasValue)
        {
            _filteredLocations = _filteredLocations.Where( l => l.LocationType == _selectedLocationType.Value ).ToList();
        }

        // 按状态筛选
        if (_selectedLocationStatus.HasValue)
        {
            _filteredLocations = _filteredLocations.Where( l =>
            {
                var status = GetLocationStatus( l );
                return _selectedLocationStatus.Value switch
                {
                    LocationStatusFilter.空闲 => status == DetailedLocationStatus.空闲,
                    LocationStatusFilter.仅托盘 => status == DetailedLocationStatus.仅托盘,
                    LocationStatusFilter.托盘和产品 => status == DetailedLocationStatus.完整,
                    LocationStatusFilter.异常状态 => status == DetailedLocationStatus.异常,
                    _ => true
                };
            } ).ToList();
        }

        // 按搜索文本筛选
        if (!string.IsNullOrWhiteSpace( _locationSearchText ))
        {
            _filteredLocations = _filteredLocations.Where( l =>
                l.LocationId.Contains( _locationSearchText , StringComparison.OrdinalIgnoreCase ) ||
                l.LocationName.Contains( _locationSearchText , StringComparison.OrdinalIgnoreCase ) ||
                (!string.IsNullOrEmpty( l.CurrentPalletId ) && l.CurrentPalletId.Contains( _locationSearchText , StringComparison.OrdinalIgnoreCase )) ||
                (!string.IsNullOrEmpty( l.CurrentProductId ) && l.CurrentProductId.Contains( _locationSearchText , StringComparison.OrdinalIgnoreCase ))
            ).ToList();
        }
        GroupLocationsByType();
    }

    private void FilterDockingPositions( )
    {
        _filteredDockingPositions = _dockingPositions;

        // 按状态筛选
        if (_selectedDockingStatus.HasValue)
        {
            _filteredDockingPositions = _filteredDockingPositions.Where( p =>
            {
                var status = GetDockingPositionStatus( p );
                return _selectedDockingStatus.Value switch
                {
                    DockingStatusFilter.空闲 => status == DetailedDockingStatus.空闲,
                    DockingStatusFilter.仅托盘 => status == DetailedDockingStatus.仅托盘,
                    DockingStatusFilter.托盘和产品 => status == DetailedDockingStatus.完整,
                    DockingStatusFilter.异常状态 => status == DetailedDockingStatus.异常,
                    _ => true
                };
            } ).ToList();
        }

        // 按搜索文本筛选
        if (!string.IsNullOrWhiteSpace( _dockingSearchText ))
        {
            _filteredDockingPositions = _filteredDockingPositions.Where( p =>
                p.PositionId.Contains( _dockingSearchText , StringComparison.OrdinalIgnoreCase ) ||
                p.PositionType.Contains( _dockingSearchText , StringComparison.OrdinalIgnoreCase ) ||
                (p.StationId != null && p.StationId.Contains( _dockingSearchText , StringComparison.OrdinalIgnoreCase )) ||
                (!string.IsNullOrEmpty( p.CurrentPalletId ) && p.CurrentPalletId.Contains( _dockingSearchText , StringComparison.OrdinalIgnoreCase )) ||
                (!string.IsNullOrEmpty( p.CurrentProductld ) && p.CurrentProductld.Contains( _dockingSearchText , StringComparison.OrdinalIgnoreCase ))
            ).ToList();
        }

        GroupDockingPositionsByType();
    }

    private void GroupLocationsByType( )
    {
        _groupedLocations = _filteredLocations
            .GroupBy( l => l.LocationType )
            .ToDictionary( g => g.Key , g => g.ToList() );
    }

    private void GroupDockingPositionsByType( )
    {
        _groupedDockingPositions = _filteredDockingPositions
            .GroupBy( p => p.PositionType ?? "未分类" )
            .ToDictionary( g => g.Key , g => g.ToList() );
    }

    // 修改统计方法
    private (int empty, int palletOnly, int full, int abnormal, int total) GetLocationTypeStats( LocationType type )
    {
        if (!_groupedLocations.ContainsKey( type ))
            return (0, 0, 0, 0, 0);

        var locations = _groupedLocations [ type ];
        var empty = locations.Count( l => GetLocationStatus( l ) == DetailedLocationStatus.空闲 );
        var palletOnly = locations.Count( l => GetLocationStatus( l ) == DetailedLocationStatus.仅托盘 );
        var full = locations.Count( l => GetLocationStatus( l ) == DetailedLocationStatus.完整 );
        var abnormal = locations.Count( l => GetLocationStatus( l ) == DetailedLocationStatus.异常 );
        var total = locations.Count;

        return (empty, palletOnly, full, abnormal, total);
    }

    private (int empty, int palletOnly, int full, int abnormal, int total) GetDockingPositionTypeStats( string positionType )
    {
        if (!_groupedDockingPositions.ContainsKey( positionType ))
            return (0, 0, 0, 0, 0);

        var positions = _groupedDockingPositions [ positionType ];
        var empty = positions.Count( p => GetDockingPositionStatus( p ) == DetailedDockingStatus.空闲 );
        var palletOnly = positions.Count( p => GetDockingPositionStatus( p ) == DetailedDockingStatus.仅托盘 );
        var full = positions.Count( p => GetDockingPositionStatus( p ) == DetailedDockingStatus.完整 );
        var abnormal = positions.Count( p => GetDockingPositionStatus( p ) == DetailedDockingStatus.异常 );
        var total = positions.Count;

        return (empty, palletOnly, full, abnormal, total);
    }

    // 其他现有方法保持不变
    private string GetLocationTypeClass( LocationType type )
    {
        return type switch
        {
            LocationType.缓存区_待试验 => "type-cache-pending",
            LocationType.缓存区_已试验 => "type-cache-tested",
            LocationType.试验区接驳位 => "type-test-dock",
            LocationType.成品检测接驳位 => "type-quality-dock",
            LocationType.护箱备料区 => "type-case-prep",
            LocationType.产线接驳位 => "type-production-dock",
            _ => "type-default"
        };
    }

    private string GetDockingPositionTypeClass( string positionType )
    {
        return positionType?.ToLower() switch
        {
            var type when type.Contains( "试验" ) => "type-test-dock",
            var type when type.Contains( "检测" ) || type.Contains( "质检" ) => "type-quality-dock",
            var type when type.Contains( "产线" ) || type.Contains( "生产" ) => "type-production-dock",
            var type when type.Contains( "缓存" ) || type.Contains( "待料" ) => "type-cache-dock",
            var type when type.Contains( "备料" ) || type.Contains( "准备" ) => "type-prep-dock",
            var type when type.Contains( "转运" ) || type.Contains( "中转" ) => "type-transfer-dock",
            _ => "type-default-dock"
        };
    }

    private string GetDockingPositionTypeDisplayName( string positionType )
    {
        return positionType switch
