    // 产品管理相关方法
    private async Task ManageProduct( Location location )
    {
        if (!string.IsNullOrEmpty( location.CurrentProductId ))
        {
            // 移除产品
            if (await ModalService.ConfirmAsync( new ConfirmOptions
                {
                    Title = "确认移除产品" ,
                    Content = $"确定要从库位 {location.LocationId} 移除产品 {location.CurrentProductId} 吗?" ,
                    OkText = "确定" ,
                    CancelText = "取消"
                } ))
            {
                try
                {
                    await LocationService.RemoveProductFromLocationAsync( location.LocationId );
                    await NotificationService.Success( new NotificationConfig { Message = "产品移除成功" } );
                    await LoadLocations();
                }
                catch (Exception ex)
                {
                    await NotificationService.Error( new NotificationConfig
                        {
                            Message = "产品移除失败" ,
                            Description = ex.Message
                        } );
                }
            }
        }
        else
        {
            var options = new ModalOptions
                {
                    Title = $"分配产品到库位 - {location.LocationId}" ,
                    Width = 500 ,
                    OnOk = async _ =>
                    {
                        await LoadLocations();
                    }
                };

            await ModalService.CreateModalAsync<AssignProductModal , AssignProductModalModel>(
                options ,
                new AssignProductModalModel { LocationId = location.LocationId }
            );
        }
    }

