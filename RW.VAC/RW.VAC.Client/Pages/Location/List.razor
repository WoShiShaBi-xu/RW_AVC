        {
            await NotificationService.Warning( new NotificationConfig
                {
                    Message = "无法删除" ,
                    Description = "该库位当前有托盘或产品占用，无法删除"
                } );
            return;
        }

        if (await ModalService.ConfirmAsync( new ConfirmOptions
            {
                Title = "确认删除库位" ,
                Content = $"确定要删除库位 {location.LocationId} ({location.LocationName}) 吗？\n此操作不可逆！" ,
                OkText = "确定删除" ,
                CancelText = "取消" ,
                OkType = "danger"
            } ))
        {
            try
            {
                await LocationService.DeleteLocationAsync( location.LocationId );
                await NotificationService.Success( new NotificationConfig { Message = "库位删除成功" } );
                await LoadLocations();
            }
            catch (Exception ex)
            {
                await NotificationService.Error( new NotificationConfig
